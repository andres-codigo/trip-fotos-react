{
	"name": "trip-fotos-react",
	"version": "0.21.5",
	"private": true,
	"description": "Conversion to React and extension of Udemy's Vue - The Complete Guide (incl. Router & Composition API) 'Find a coach' project.",
	"type": "module",
	"scripts": {
		"dev": "VITE_OPEN=true vite",
		"build": "vite build",
		"build:preview": "vite preview",
		"analyse": "vite-bundle-visualizer -o dist/stats.html --open false && vite preview --open /stats.html",
		"lint": "eslint src cypress --config config/eslint.config.mjs --report-unused-disable-directives --max-warnings 0",
		"lint:fix": "eslint src cypress --fix --config config/eslint.config.mjs --report-unused-disable-directives --max-warnings 0 && npm run format",
		"format": "prettier --write '**/*.{js,jsx,ts,tsx,config.js,config.mjs,css,json,md}' '.devcontainer/**/*.json' '.github/**/*.{yml,yaml,md}'",
		"vitest:run": "vitest run --reporter=dot",
		"vitest:watch": "vitest watch",
		"vitest:coverage": "vitest --coverage",
		"cy:open:e2e": "cypress open --e2e",
		"cy:open:ct": "cypress open --component",
		"cy:run:e2e:live": "node .claude/skills/verify/run-e2e.mjs",
		"cy:run:e2e:emulators": "npx firebase-tools@15.34.2 emulators:exec --project demo-trip-fotos \"npm run emulators:seed && E2E_EMULATORS=true node .claude/skills/verify/run-e2e.mjs\"",
		"cy:run:ct": "cypress run --component",
		"cy:run:auto": "bash -c 'if [[ \"$0\" == *\"src/components\"* ]]; then cypress run --component --spec \"$0\"; else cypress run --spec \"$0\"; fi'",
		"firebase:rules": "npx firebase-tools@15.34.2 deploy --only database,storage",
		"emulators": "npx firebase-tools@15.34.2 emulators:start --project demo-trip-fotos",
		"emulators:seed": "node scripts/seed-emulators.mjs",
		"admin:claim": "node scripts/set-admin-claim.mjs"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.3.1",
		"@reduxjs/toolkit": "^2.14.0",
		"@tailwindcss/vite": "^4.3.4",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"browser-image-compression": "^2.0.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"prop-types": "^15.8.1",
		"react-redux": "^9.3.1",
		"redux": "^5.0.1",
		"redux-persist": "^6.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.4"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^9.39.5",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@vitejs/plugin-react": "^6.2.1",
		"@vitest/coverage-v8": "^5.1.0",
		"@vitest/eslint-plugin": "^1.6.28",
		"axe-core": "^4.14.0",
		"cypress": "^16.2.1",
		"dotenv": "^18.0.9",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-cypress": "^6.4.4",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"firebase": "^13.2.0",
		"firebase-admin": "^14.5.0",
		"globals": "^17.14.0",
		"jsdom": "^30.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.5",
		"vite": "^8.3.5",
		"vite-bundle-visualizer": "^1.2.1",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"browserslist": {
		"production": [
			"defaults"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"cypress@16.2.1": true,
		"@firebase/util@1.15.3": true,
		"protobufjs@7.6.6": true
	}
}
