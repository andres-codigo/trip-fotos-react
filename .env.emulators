# Loaded by `npm run dev -- --mode emulators` over .env. Local emulators only: no secrets, never set these in Vercel.
# Start the emulators first with `npm run emulators`.

VITE_USE_FIREBASE_EMULATORS=true

# 127.0.0.1, not localhost: the browser reaches it over plain HTTP from the HTTP or HTTPS app
VITE_API_URL='http://127.0.0.1:9099/identitytoolkit.googleapis.com/v1/accounts:'
VITE_API_KEY='demo-api-key'

# The Realtime Database emulator serves requests without a namespace from one that has no rules
VITE_BACKEND_BASE_URL='http://127.0.0.1:9000'
VITE_DATABASE_NAMESPACE='demo-trip-fotos-default-rtdb'

VITE_FIREBASE_API_KEY='demo-api-key'
VITE_FIREBASE_AUTH_DOMAIN='demo-trip-fotos.firebaseapp.com'
VITE_DATABASE_URL=$VITE_BACKEND_BASE_URL
VITE_FIREBASE_PROJECT_ID='demo-trip-fotos'
VITE_FIREBASE_STORAGE_BUCKET='demo-trip-fotos.appspot.com'
VITE_FIREBASE_MESSAGING_SENDER_ID='0'
VITE_FIREBASE_APP_ID='demo-app-id'
