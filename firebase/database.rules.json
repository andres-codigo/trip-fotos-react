{
	"rules": {
		"travellers": {
			".read": "auth != null",
			"$uid": {
				".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
				".validate": "newData.hasChild('files')",
				"tripStart": {
					".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.parent().child('tripEnd').isString()"
				},
				"tripEnd": {
					".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.parent().child('tripStart').isString() && newData.val() >= newData.parent().child('tripStart').val()"
				},
				"daysInCity": {
					".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 366"
				},
				"fileDimensions": {
					"$index": {
						".validate": "$index.matches(/^[0-9]+$/) && newData.hasChildren(['width', 'height'])",
						"width": {
							".validate": "newData.isNumber() && newData.val() > 0"
						},
						"height": {
							".validate": "newData.isNumber() && newData.val() > 0"
						},
						"$other": {
							".validate": false
						}
					}
				},
				"fileAlts": {
					"$index": {
						".validate": "$index.matches(/^[0-9]+$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
					}
				},
				"fileThumbnails": {
					"$index": {
						".validate": "$index.matches(/^[0-9]+$/)",
						"$size": {
							".validate": "$size.matches(/^[0-9]+$/) && newData.hasChildren(['width', 'url'])",
							"width": {
								".validate": "newData.isNumber() && newData.val() > 0"
							},
							"url": {
								".validate": "newData.isString() && newData.val().length <= 2048"
							},
							"$other": {
								".validate": false
							}
						}
					}
				}
			}
		},
		"publicTrips": {
			".read": true,
			"$uid": {
				".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
				".validate": "newData.hasChildren(['firstName', 'cities'])",
				"firstName": {
					".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
				},
				"lastInitial": {
					".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2"
				},
				"cities": {
					".validate": "newData.hasChildren()"
				},
				"tripStart": {
					".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.parent().child('tripEnd').isString()"
				},
				"tripEnd": {
					".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.parent().child('tripStart').isString() && newData.val() >= newData.parent().child('tripStart').val()"
				},
				"daysInCity": {
					".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 366"
				},
				"photos": {
					".validate": "newData.hasChildren()",
					"$index": {
						".validate": "$index.matches(/^[0-2]$/) && newData.hasChild('url')",
						"url": {
							".validate": "newData.isString() && newData.val().length <= 2048"
						},
						"alt": {
							".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
						},
						"dimensions": {
							".validate": "newData.hasChildren(['width', 'height'])",
							"width": {
								".validate": "newData.isNumber() && newData.val() > 0"
							},
							"height": {
								".validate": "newData.isNumber() && newData.val() > 0"
							},
							"$other": {
								".validate": false
							}
						},
						"thumbnails": {
							"$size": {
								".validate": "$size.matches(/^[0-9]+$/) && newData.hasChildren(['width', 'url'])",
								"width": {
									".validate": "newData.isNumber() && newData.val() > 0"
								},
								"url": {
									".validate": "newData.isString() && newData.val().length <= 2048"
								},
								"$other": {
									".validate": false
								}
							}
						},
						"$other": {
							".validate": false
						}
					}
				},
				"$other": {
					".validate": false
				}
			}
		},
		"messages": {
			"$travellerId": {
				".read": "auth != null && (auth.uid === $travellerId || auth.token.admin === true)",
				".write": "auth != null && !newData.exists() && (auth.uid === $travellerId || auth.token.admin === true)",
				"$messageId": {
					".write": "(auth != null && !data.exists() && newData.exists() && auth.uid !== $travellerId && newData.child('senderId').val() === auth.uid && root.child('travellers/' + auth.uid).exists()) || (auth != null && !newData.exists() && (auth.uid === $travellerId || auth.token.admin === true))",
					".validate": "root.child('travellers/' + $travellerId).exists() && newData.hasChildren(['senderId', 'message', 'createdAt', 'read'])",
					"senderId": {
						".validate": "newData.isString() && newData.val() === auth.uid"
					},
					"message": {
						".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 5000"
					},
					"createdAt": {
						".validate": "newData.isNumber() && newData.val() === now"
					},
					"read": {
						".write": "auth != null && auth.uid === $travellerId && data.parent().exists() && newData.val() === true",
						".validate": "newData.isBoolean() && newData.val() === data.parent().exists()"
					},
					"$other": {
						".validate": false
					}
				}
			}
		}
	}
}
