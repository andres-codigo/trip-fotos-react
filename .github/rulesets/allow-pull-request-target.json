{
	"name": "Allow pull_request_target for labelling and project lifecycle",
	"enforcement": "active",
	"conditions": {
		"workflow_path": {
			"include": [
				".github/workflows/github-auto-label-prs.yml",
				".github/workflows/project-item-lifecycle.yml"
			],
			"exclude": []
		}
	},
	"rules": [
		{
			"type": "restrict_action_events",
			"parameters": { "allowed_events": ["pull_request_target"] }
		}
	]
}
