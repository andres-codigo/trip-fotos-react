{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run lint)",
			"Bash(npm run lint:fix)",
			"Bash(npm run vitest:run)",
			"Bash(npm run vitest:run:fast)",
			"Bash(npm run vitest:coverage)",
			"Bash(npm run cy:run:ct)",
			"Bash(npm run build)",
			"Bash(npx eslint *)",
			"Bash(npx prettier *)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git branch *)"
		],
		"ask": [
			"Bash(git push *)",
			"Bash(gh pr create *)",
			"Bash(npm install *)",
			"Bash(npm run cy:run:e2e)",
			"Bash(node .claude/skills/verify/run-e2e.mjs*)"
		],
		"deny": [
			"Read(./.env)",
			"Read(./certs/**)",
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(git reset --hard *)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.mjs\"",
						"timeout": 60
					}
				]
			}
		]
	}
}
