{
	"name": "claude-code-dev",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/java:1": {
			"version": "21"
		}
	},
	"remoteUser": "vscode",
	"forwardPorts": [3000, 4000, 9000, 9099, 9199],
	"portsAttributes": {
		"3000": { "label": "Vite dev server" },
		"4000": { "label": "Firebase Emulator UI" },
		"9000": { "label": "Realtime Database emulator" },
		"9099": { "label": "Auth emulator" },
		"9199": { "label": "Storage emulator" }
	},
	"otherPortsAttributes": {
		"onAutoForward": "silent"
	},
	"containerEnv": {
		"GIT_CONFIG_GLOBAL": "/home/vscode/.config/git/config",
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"github.vscode-github-actions",
				"github.vscode-pull-request-github",
				"ms-azuretools.vscode-containers",
				"redhat.vscode-yaml",
				"streetsidesoftware.code-spell-checker",
				"streetsidesoftware.code-spell-checker-british-english",
				"toba.vsfire",
				"vitest.explorer"
			],
			"settings": {
				"remote.restoreForwardedPorts": false,
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"editor.codeActionsOnSave": {
					"source.fixAll.eslint": "always"
				}
			}
		}
	},
	"mounts": [
		"source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
		"source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind",
		"source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind",
		"source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
		"source=${localWorkspaceFolderBasename}-npm-cache,target=/home/vscode/.npm,type=volume",
		"source=${localWorkspaceFolderBasename}-cypress-cache,target=/home/vscode/.cache/Cypress,type=volume"
	],
	"onCreateCommand": "sudo chown -R vscode:vscode ${containerWorkspaceFolder}/node_modules /home/vscode/.npm /home/vscode/.cache",
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends xvfb libgtk2.0-0 libgtk-3-0 libgbm-dev libnotify-dev libnss3 libxss1 libasound2t64 libxtst6 xauth && npm config set allow-scripts=@anthropic-ai/claude-code --location=user && npm install -g @anthropic-ai/claude-code && npm install && npx cypress verify && mkdir -p /home/vscode/.config/git && git config --global --get-all safe.directory | grep -Fxq /workspaces/trip-fotos-react || git config --global --add safe.directory /workspaces/trip-fotos-react"
}
