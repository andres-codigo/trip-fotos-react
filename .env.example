# Copy to .env and fill in the values from Firebase Console > Project settings > Your apps > firebaseConfig.
# Never commit .env.

VITE_ROOT_URL='http://localhost:3000' # Cypress baseUrl

# Firebase Auth REST API (profile updates and E2E intercepts)
VITE_API_URL='https://identitytoolkit.googleapis.com/v1/accounts:'
VITE_API_KEY='' # firebaseConfig > apiKey

# Firebase Realtime Database
VITE_BACKEND_BASE_URL='' # firebaseConfig > databaseURL

# Firebase SDK
VITE_FIREBASE_API_KEY='' # firebaseConfig > apiKey
VITE_FIREBASE_AUTH_DOMAIN='' # firebaseConfig > authDomain
VITE_DATABASE_URL=$VITE_BACKEND_BASE_URL
VITE_FIREBASE_PROJECT_ID='' # firebaseConfig > projectId
VITE_FIREBASE_STORAGE_BUCKET='' # firebaseConfig > storageBucket
VITE_FIREBASE_MESSAGING_SENDER_ID='' # firebaseConfig > messagingSenderId
VITE_FIREBASE_APP_ID='' # firebaseConfig > appId

# Cypress E2E sign-in (an existing test account in the Firebase project)
CYPRESS_USER_EMAIL=''
CYPRESS_USER_PASSWORD=''

# Optional: open the browser when the dev server starts
VITE_OPEN=false
